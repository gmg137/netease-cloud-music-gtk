<?xml version="1.0" encoding="UTF-8"?>
<interface>
    <requires lib="gtk" version="4.0" />
    <requires lib="libadwaita" version="1.0" />
    <template class="LocalMusicPage" parent="AdwBin">
        <property name="child">
            <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">6</property>
                <property name="margin-top">6</property>
                <property name="margin-bottom">6</property>
                <property name="margin-start">12</property>
                <property name="margin-end">12</property>
                <child>
                    <object class="GtkBox">
                        <property name="spacing">6</property>
                        <child>
                            <object class="GtkSearchEntry" id="filter_entry">
                                <property name="placeholder-text" translatable="yes">Search local music</property>
                                <property name="hexpand">true</property>
                            </object>
                        </child>
                        <child>
                            <object class="GtkButton" id="play_all_button">
                                <property name="label" translatable="yes">Play All</property>
                                <property name="tooltip-text" translatable="yes">Play all local songs in the list</property>
                            </object>
                        </child>
                        <child>
                            <object class="GtkButton" id="rescan_button">
                                <property name="label" translatable="yes">Rescan</property>
                                <property name="tooltip-text" translatable="yes">Rescan remembered local music folders</property>
                            </object>
                        </child>
                    </object>
                </child>
                <child>
                    <object class="GtkBox">
                        <property name="spacing">0</property>
                        <property name="halign">start</property>
                        <style>
                            <class name="linked" />
                        </style>
                        <child>
                            <object class="GtkToggleButton" id="mode_all">
                                <property name="label" translatable="yes">All</property>
                                <property name="active">true</property>
                            </object>
                        </child>
                        <child>
                            <object class="GtkToggleButton" id="mode_fav">
                                <property name="label" translatable="yes">Favorites</property>
                                <property name="group">mode_all</property>
                            </object>
                        </child>
                        <child>
                            <object class="GtkToggleButton" id="mode_recommend">
                                <property name="label" translatable="yes">For You</property>
                                <property name="group">mode_all</property>
                                <property name="tooltip-text" translatable="yes">Picked from your local favorites and listening time</property>
                            </object>
                        </child>
                        <child>
                            <object class="GtkToggleButton" id="mode_recent">
                                <property name="label" translatable="yes">Recent</property>
                                <property name="group">mode_all</property>
                            </object>
                        </child>
                    </object>
                </child>
                <child>
                    <object class="GtkLabel" id="hint_label">
                        <property name="visible">false</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <style>
                            <class name="dim-label" />
                            <class name="caption" />
                        </style>
                    </object>
                </child>
                <child>
                    <object class="SongListView" id="songs_list">
                        <property name="vexpand">true</property>
                        <property name="width-request">500</property>
                        <property name="clamp-maximum-size">1000</property>
                        <property name="clamp-tightening-threshold">730</property>
                    </object>
                </child>
            </object>
        </property>
    </template>
</interface>
